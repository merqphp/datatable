            "optional": true
        }
    },
    "devDependencies": {
        "@types/node": "^24.0.0",
        "@types/react": "^19.3.0",
        "react": "^19.3.1",
        "typescript": "~5.9.3",
        "unplugin-vue": "^8.0.1",
        "vite-plus": "^1.6.0",
        "vue": "^3.5.45",
        "vue-tsc": "^3.3.14"
