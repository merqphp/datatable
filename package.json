    "description": "Headless tables for Laravel and Inertia.",
    "type": "module",
    "license": "MIT",
    "sideEffects": false,
    "packageManager": "pnpm@10.32.1",
    "engines": {
        "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
