{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "merq/datatable",
    "description": "Headless tables for Laravel and Inertia.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Merq\\DataTable\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Merq\\DataTable\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Merq\\DataTable\\DataTableServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "@php vendor/bin/pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    }
}
